# --- Required ---
PIEFED_URL=https://piefed.example.com
# openssl rand -hex 32
SECRET_KEY=change-me

# Talk to PieFed directly instead of back out through Caddy, so PieFed
# sees each visitor's IP in X-Forwarded-For (per-visitor rate limits).
PIEFED_API_BASE=http://127.0.0.1:8030
PIEFED_HOST_HEADER=piefed.example.com

# --- Optional ---
FORUM_TITLE=My Forums
# 1 = anonymous visitors only get the login page
LOGIN_REQUIRED=0
TIMEZONE=Europe/Amsterdam
PIEFED_TIMEOUT=15
# 0 only for plain-http local testing
SECURE_COOKIES=1
# 1 = fetch remote avatars/images through PieBB so other instances don't see visitor IPs
IMAGE_PROXY=1
